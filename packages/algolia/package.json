{
    "name": "@nativescript-community/algolia",
    "version": "2.0.2",
    "description": "NativeScript plugin for Algolia search. This plugin is designed to mirror, as closely as possible, the structure of Algolia’s JavaScript client.",
    "main": "./algolia",
    "typings": "./algolia.d.ts",
    "scripts": {
        "build": "npm run tsc && npm run readme",
        "readme": "readme generate -c ../../tools/readme/blueprint.json",
        "tsc": "cpy '**/*.d.ts' '../../packages/algolia' --parents --cwd=../../src/algolia && tsc  --build",
        "clean": "bin/rimraf ./*.d.ts ./*.js ./*.js.map ./*.tsbuildinfo ./*.mjs ./*.mjs.map ./angular ./svelte ./vue* ./react",
        "build.all": "npm run build"
    },
    "nativescript": {
        "platforms": {
            "android": "6.0.0",
            "ios": "6.0.0"
        }
    },
    "keywords": [
        "NativeScript",
        "JavaScript",
        "Android",
        "iOS",
        "algolia",
        "search"
    ],
    "bugs": {
        "url": "https://github.com/nativescript-community/algolia/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/nativescript-community/algolia"
    },
    "license": "Apache-2.0",
    "readmeFilename": "README.md"
}
